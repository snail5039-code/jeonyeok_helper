# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 Git에 올라가지 않습니다)

# Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 답변 작성의 생각 예산 (0 = 끔: 빠르지만 넓은 질문에 답이 좁아짐)
GEMINI_THINKING_BUDGET=1024
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# 국가법령정보센터 Open API — https://open.law.go.kr
LAW_API_OC=

# 공공데이터포털 '행정안전부_대한민국 공공서비스(혜택) 정보' — https://www.data.go.kr
# 마이페이지의 '일반 인증키(Decoding)' 값을 넣으세요.
DATA_GO_KR_SERVICE_KEY=

# 온통청년 청년정책 OPEN API — https://www.youthcenter.go.kr (마이페이지 > OPEN API)
YOUTHCENTER_API_KEY=
