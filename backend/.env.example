# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 Git에 올라가지 않습니다)

# Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 답변 작성의 생각 예산 (0 = 끔: 빠르지만 넓은 질문에 답이 좁아짐)
GEMINI_THINKING_BUDGET=1024
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# 국가법령정보센터 Open API — https://open.law.go.kr
LAW_API_OC=

# 공공데이터포털 '행정안전부_대한민국 공공서비스(혜택) 정보' — https://www.data.go.kr
# 마이페이지의 '일반 인증키(Decoding)' 값을 넣으세요.
DATA_GO_KR_SERVICE_KEY=

# 온통청년 청년정책 OPEN API — https://www.youthcenter.go.kr (마이페이지 > OPEN API)
YOUTHCENTER_API_KEY=

# PostgreSQL(pgvector): 규정 검색 벡터와 피드백 저장. 로컬은 프로젝트 폴더에서 docker compose up -d db
DATABASE_URL=postgresql+psycopg://jeonyeok:jeonyeok@localhost:5432/jeonyeok

# 브라우저 알림(Web Push) VAPID 키. 없으면 알림 켜기 버튼이 숨는다. 만드는 법:
#   npx web-push generate-vapid-keys 의 Public/Private 값을 그대로 넣는다.
# SUBJECT는 푸시 서비스가 문제 있을 때 연락할 곳: 서비스 주소(https://도메인, 경로 없이) 또는 mailto:메일
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 운영 대시보드(/admin) 열쇠. 비어 있으면 대시보드가 꺼진다. 긴 무작위 값으로:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
